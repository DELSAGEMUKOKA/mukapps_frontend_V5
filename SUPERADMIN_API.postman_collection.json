{
  "info": {
    "name": "MukApps - SuperAdmin API",
    "description": "Collection complète pour tester toutes les routes SuperAdmin de MukApps",
    "_postman_id": "mukapps-superadmin-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token superadmin - rempli automatiquement après login"
    },
    {
      "key": "companyId",
      "value": "",
      "type": "string",
      "description": "ID d'une company - rempli automatiquement après création"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "ID d'un utilisateur"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login SuperAdmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token sauvegardé:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@mukapps.com\",\n  \"password\": \"SuperAdmin@2024!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Connexion en tant que SuperAdmin. Le token JWT est sauvegardé automatiquement dans la variable 'token'."
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Statistiques Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/superadmin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "dashboard", "stats"]
            },
            "description": "Retourne les statistiques globales : nombre de companies, utilisateurs, ventes, revenus, companies par plan, companies récentes."
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Lister toutes les companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Recherche par nom ou email",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "description": "Filtre par statut : ACTIVE | TRIAL | EXPIRED | CANCELLED",
                  "disabled": true
                },
                {
                  "key": "plan",
                  "value": "PREMIUM",
                  "description": "Filtre par plan : FREE | BASIC | PREMIUM | ENTERPRISE",
                  "disabled": true
                }
              ]
            },
            "description": "Liste toutes les companies avec pagination. Filtres optionnels : search, status, plan."
          }
        },
        {
          "name": "Créer une company",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('companyId', res.data.id);",
                  "  console.log('Company ID sauvegardé:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Entreprise Test SARL\",\n  \"email\": \"contact@entreprisetest.com\",\n  \"phone\": \"+243812345678\",\n  \"address\": \"123 Avenue de la Paix, Kinshasa, RDC\",\n  \"adminEmail\": \"admin@entreprisetest.com\",\n  \"adminPassword\": \"Admin@2024!\",\n  \"adminFirstName\": \"Jean\",\n  \"adminLastName\": \"Dupont\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies"]
            },
            "description": "Crée une nouvelle company avec son administrateur. L'ID de la company est sauvegardé automatiquement. La company est créée en mode TRIAL (1 jour)."
          }
        },
        {
          "name": "Détails d'une company",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}"]
            },
            "description": "Retourne les détails complets d'une company : utilisateurs, modules souscrits, compteurs (produits, ventes, paiements...)."
          }
        },
        {
          "name": "Modifier une company",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Entreprise Test SARL (Modifiée)\",\n  \"email\": \"nouveau@entreprisetest.com\",\n  \"phone\": \"+243899999999\",\n  \"address\": \"456 Boulevard du Commerce, Kinshasa, RDC\",\n  \"logo\": \"https://example.com/logo.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}"]
            },
            "description": "Modifie les informations d'une company (nom, email, téléphone, adresse, logo)."
          }
        },
        {
          "name": "Activer une company",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}", "status"]
            },
            "description": "Active une company (isActive: true)."
          }
        },
        {
          "name": "Suspendre une company",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}", "status"]
            },
            "description": "Suspend une company (isActive: false)."
          }
        },
        {
          "name": "Supprimer une company",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}"]
            },
            "description": "Supprime définitivement une company et toutes ses données. Action irréversible."
          }
        }
      ]
    },
    {
      "name": "Abonnements (Subscriptions)",
      "item": [
        {
          "name": "Activer un abonnement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"PREMIUM\",\n  \"durationMonths\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}/subscription/activate",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}", "subscription", "activate"]
            },
            "description": "Active un abonnement pour une company.\n\nPlans disponibles : FREE | BASIC | PREMIUM | ENTERPRISE\ndurationMonths : durée en mois (ex: 1, 3, 6, 12)"
          }
        },
        {
          "name": "Activer abonnement - Plan BASIC 3 mois",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"BASIC\",\n  \"durationMonths\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}/subscription/activate",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}", "subscription", "activate"]
            },
            "description": "Active un abonnement BASIC pour 3 mois."
          }
        },
        {
          "name": "Activer abonnement - Plan ENTERPRISE 1 mois",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"ENTERPRISE\",\n  \"durationMonths\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}/subscription/activate",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}", "subscription", "activate"]
            },
            "description": "Active un abonnement ENTERPRISE pour 1 mois."
          }
        },
        {
          "name": "Prolonger un abonnement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationMonths\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}/subscription/extend",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}", "subscription", "extend"]
            },
            "description": "Prolonge l'abonnement existant d'une company. Si l'abonnement est expiré, repart de la date actuelle. Sinon, s'ajoute à la date d'expiration actuelle."
          }
        },
        {
          "name": "Annuler un abonnement",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/companies/{{companyId}}/subscription/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "companies", "{{companyId}}", "subscription", "cancel"]
            },
            "description": "Annule l'abonnement d'une company. Le statut passe à CANCELLED. Aucun body requis."
          }
        }
      ]
    },
