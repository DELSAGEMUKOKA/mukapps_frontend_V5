{
  "info": {
    "_postman_id": "hotel-module-v1",
    "name": "MUKAPPS — Module Hôtellerie",
    "description": "Collection complète des routes du module hôtellerie.\n\nBase URL: {{baseUrl}}/api/hotel\nAuthentification: Bearer Token JWT\n\nVariables requises:\n- baseUrl: http://localhost:3000\n- token: JWT obtenu via POST /api/auth/login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://mukappss.online", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "roomTypeId", "value": "", "type": "string" },
    { "key": "roomId", "value": "", "type": "string" },
    { "key": "rateId", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "stayId", "value": "", "type": "string" },
    { "key": "serviceId", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "billId", "value": "", "type": "string" },
    { "key": "guestId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 — Types de Chambres",
      "item": [
        {
          "name": "Lister les types de chambres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotel/room-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "room-types"]
            }
          }
        },
        {
          "name": "Créer un type de chambre",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) pm.collectionVariables.set('roomTypeId', res.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chambre Standard\",\n  \"description\": \"Chambre confortable avec vue sur jardin\",\n  \"basePrice\": 85000,\n  \"maxOccupancy\": 2,\n  \"bedType\": \"DOUBLE\",\n  \"amenities\": [\"wifi\", \"climatisation\", \"tv\"],\n  \"sortOrder\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/room-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "room-types"]
            }
          }
        },
        {
          "name": "Créer un type — Suite Junior",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suite Junior\",\n  \"description\": \"Suite spacieuse avec salon et vue sur piscine\",\n  \"basePrice\": 150000,\n  \"maxOccupancy\": 3,\n  \"bedType\": \"KING\",\n  \"amenities\": [\"wifi\", \"climatisation\", \"tv\", \"minibar\", \"jacuzzi\"],\n  \"sortOrder\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/room-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "room-types"]
            }
          }
        },
        {
          "name": "Détails d'un type de chambre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotel/room-types/{{roomTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "room-types", "{{roomTypeId}}"]
            }
          }
        },
        {
          "name": "Modifier un type de chambre",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chambre Standard Deluxe\",\n  \"basePrice\": 90000,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/room-types/{{roomTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "room-types", "{{roomTypeId}}"]
            }
          }
        },
        {
          "name": "Supprimer un type de chambre",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotel/room-types/{{roomTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "room-types", "{{roomTypeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "02 — Chambres",
      "item": [
        {
          "name": "Vue d'ensemble des chambres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms/overview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms", "overview"]
            }
          }
        },
        {
          "name": "Disponibilité des chambres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms/availability?checkIn=2026-07-01&checkOut=2026-07-04&roomTypeId={{roomTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms", "availability"],
              "query": [
                { "key": "checkIn", "value": "2026-07-01" },
                { "key": "checkOut", "value": "2026-07-04" },
                { "key": "roomTypeId", "value": "{{roomTypeId}}" }
              ]
            }
          }
        },
        {
          "name": "Lister les chambres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms?status=LIBRE&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms"],
              "query": [
                { "key": "status", "value": "LIBRE" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Créer une chambre",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) pm.collectionVariables.set('roomId', res.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"number\": \"101\",\n  \"name\": \"Chambre Palmier\",\n  \"floor\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms"]
            }
          }
        },
        {
          "name": "Créer plusieurs chambres — lot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"number\": \"102\",\n  \"name\": \"Chambre Bougainvillée\",\n  \"floor\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms"]
            }
          }
        },
        {
          "name": "Détails d'une chambre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms/{{roomId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms", "{{roomId}}"]
            }
          }
        },
        {
          "name": "Modifier une chambre",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chambre Palmier Royale\",\n  \"floor\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms/{{roomId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms", "{{roomId}}"]
            }
          }
        },
        {
          "name": "Changer le statut d'une chambre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EN_MENAGE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms/{{roomId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms", "{{roomId}}", "status"]
            }
          }
        },
        {
          "name": "Bloquer une chambre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBlocked\": true,\n  \"blockedReason\": \"Travaux de rénovation salle de bain\",\n  \"blockedUntil\": \"2026-07-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/rooms/{{roomId}}/block",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "rooms", "{{roomId}}", "block"]
            }
          }
        },
        {
