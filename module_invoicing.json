        {
          "name": "Preview Template",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateContent\": \"<html><body><h1>Invoice #{{document.number}}</h1><p>For: {{client.name}}</p><p>Total: {{formatCurrency totals.grandTotal}}</p></body></html>\",\n  \"sampleData\": {\n    \"document\": {\n      \"number\": \"INV-2025-001\",\n      \"date\": \"2025-04-27\",\n      \"dueDate\": \"2025-05-27\"\n    },\n    \"client\": {\n      \"name\": \"Acme Corporation\",\n      \"email\": \"contact@acme.com\",\n      \"address\": \"123 Business St\"\n    },\n    \"items\": [\n      {\"description\": \"Product A\", \"quantity\": 2, \"unitPrice\": 100, \"taxRate\": 19, \"total\": 238},\n      {\"description\": \"Product B\", \"quantity\": 1, \"unitPrice\": 50, \"taxRate\": 19, \"total\": 59.5}\n    ],\n    \"totals\": {\n      \"subtotal\": 150,\n      \"discount\": 0,\n      \"taxAmount\": 28.5,\n      \"shipping\": 0,\n      \"grandTotal\": 178.5\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/invoicing/templates/preview",
              "protocol": "http",
              "host": ["{{base_url}}"],
