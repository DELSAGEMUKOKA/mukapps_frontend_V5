        {
          "name": "Render Template",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateContent\": \"<html><body><h1>Invoice #{{document.number}}</h1><table><tr><th>Item</th><th>Qty</th><th>Total</th></tr>{{#each items}}<tr><td>{{this.description}}</td><td>{{this.quantity}}</td><td>{{formatCurrency this.total}}</td></tr>{{/each}}</table><p>Grand Total: {{formatCurrency totals.grandTotal}}</p></body></html>\",\n  \"data\": {\n    \"document\": {\n      \"type\": \"INVOICE\",\n      \"number\": \"INV-2025-001\",\n      \"date\": \"2025-04-27\",\n      \"dueDate\": \"2025-05-27\",\n      \"currency\": \"FC\"\n    },\n    \"company\": {\n      \"name\": \"My Company\",\n      \"email\": \"info@company.com\",\n      \"phone\": \"+243123456789\",\n      \"website\": \"https://company.com\"\n    },\n    \"client\": {\n      \"name\": \"Client Name\",\n      \"email\": \"client@example.com\",\n      \"address\": \"Client Address\"\n    },\n    \"items\": [\n      {\"description\": \"Service A\", \"quantity\": 1, \"unitPrice\": 500, \"taxRate\": 19, \"total\": 595},\n      {\"description\": \"Service B\", \"quantity\": 2, \"unitPrice\": 250, \"taxRate\": 19, \"total\": 595}\n    ],\n    \"totals\": {\n      \"subtotal\": 1000,\n      \"discount\": 0,\n      \"taxAmount\": 190,\n      \"shipping\": 0,\n      \"grandTotal\": 1190\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/invoicing/templates/render",
              "protocol": "http",
              "host": ["{{base_url}}"],
