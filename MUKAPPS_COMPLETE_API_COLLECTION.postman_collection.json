    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.token) {",
                  "        pm.environment.set('token', response.data.token);",
                  "        pm.environment.set('userId', response.data.user.id);",
                  "        pm.environment.set('companyId', response.data.user.companyId);",
                  "        console.log('✅ Token saved');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin@123\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"Test\",\n  \"phone\": \"+243123456789\",\n  \"company\": {\n    \"name\": \"Test Company\",\n    \"email\": \"contact@test.com\",\n    \"phone\": \"+243987654321\"\n  }\n}"
